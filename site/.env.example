# Copy to .env.local (or set these in Vercel → Project → Settings → Environment Variables) to switch ads on.
# Nothing ad-related loads while these are empty.

# Google AdSense publisher ID, e.g. ca-pub-1234567890123456
VITE_ADSENSE_CLIENT=
# Display ad unit IDs (AdSense → Ads → By ad unit → Display ads), used on game menus and results screens
VITE_ADSENSE_SLOT_LOBBY=
VITE_ADSENSE_SLOT_SIDE=
# Interstitials between matches and rewarded ads in games (needs AdSense "H5 games ads" approval)
VITE_H5_GAME_ADS=off
# Set to "on" while testing H5 game ads so Google serves test ads (never in production)
VITE_ADSENSE_TEST=off

# Amazon Associates tracking ID, e.g. yourname-21, and the store to link to (amazon.in, amazon.com, amazon.co.uk)
VITE_AMAZON_TAG=
VITE_AMAZON_DOMAIN=amazon.in
